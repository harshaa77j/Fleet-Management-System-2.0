generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  admin_id      String    @id @db.Uuid
  email         String    @unique @db.VarChar(255)
  password_hash String
  name          String?   @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  companies     Company[]
}

model Company {
  company_id          String          @id @db.Uuid
  name                String?         @db.VarChar(100)
  email               String          @unique @db.VarChar(255)
  phone               String?         @db.VarChar(20)
  address             String?         @db.VarChar(255)
  status              CompanyStatus   @default(ACTIVE)
  created_at          DateTime        @default(now()) @db.Timestamp
  created_by_admin_id String?         @db.Uuid
  created_by_admin    Admin?          @relation(fields: [created_by_admin_id],references:[admin_id])
  managers            Manager[]       
  activationKeyId     String          @db.Uuid @unique
  activationKey       ActivationKey?  @relation(fields: [activationKeyId], references: [key_id])
}
enum CompanyStatus {
  ACTIVE
  EXPIRED
}

model ActivationKey {
  key_id             String           @id @db.Uuid
  key                String           @unique @db.VarChar(255)
  plan               String?          @db.VarChar(100)
  licence_type       String?          @db.VarChar(100)      
  start_date         DateTime?
  expires_at         DateTime?
  status             KeyStatus        @default(ACTIVE)
  company            Company?         
}
enum KeyStatus {
  ACTIVE
  EXPIRED
}

model Manager {
  manager_id           String       @id @db.Uuid @default(uuid())
  email                String       @unique @db.VarChar(255)
  password_hash        String
  name                 String?      @db.VarChar(255) 
  phone                String?      @db.VarChar(20)
  address              String?      @db.VarChar(255)
  company              Company      @relation(fields: [companyId], references: [company_id])
  companyId            String       @db.Uuid
  created_at           DateTime     @default(now()) @db.Timestamp(6)
}

model Worker {
  worker_id    String @id @default(uuid()) @db.Uuid
  biometric_id String @unique @db.VarChar(100)

  name         String @db.VarChar(255)
  phone        String? @db.VarChar(20)
  address      String? @db.VarChar(255)

  manager_id   String @db.Uuid
  company_id   String @db.Uuid

  blood_group  String?
  dependents   Int?
  dob          DateTime?
  age          Int?

  status       WorkerStatus @default(ACTIVE)
  created_at   DateTime @default(now()) @db.Timestamp(6)

  manager      Manager @relation(fields: [manager_id], references: [manager_id])
  company      Company @relation(fields: [company_id], references: [company_id])
}
enum WorkerStatus {
  ACTIVE
  INACTIVE
}
model WorkerStats {
  worker_stats_id String @id @default(uuid()) @db.Uuid

  worker_id       String @db.Uuid
  biometric_id    String @db.VarChar(100)

  attendance_status AttendanceStatus @default(ABSENT)

  start_time      DateTime?
  end_time        DateTime?

  vehicle_id      String? @db.Uuid

  created_at      DateTime @default(now()) @db.Timestamp(6)

  worker          Worker  @relation(fields: [worker_id], references: [worker_id])
}
