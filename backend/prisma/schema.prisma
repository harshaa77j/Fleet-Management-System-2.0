datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

model Admin {
  admin_id      String    @id @db.Uuid
  email         String    @unique @db.VarChar(255)
  password_hash String
  name          String?   @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  companies     Company[]
}

model Company {
  company_id          String         @id @db.Uuid
  name                String?        @db.VarChar(100)
  email               String         @unique @db.VarChar(255)
  phone               String?        @db.VarChar(20)
  address             String?        @db.VarChar(255)
  status              CompanyStatus  @default(ACTIVE)
  created_at          DateTime       @default(now()) @db.Timestamp
  created_by_admin_id String?        @db.Uuid
  created_by_admin    Admin?         @relation(fields: [created_by_admin_id], references: [admin_id])
  managers            Manager[]
  activationKeyId     String         @unique @db.Uuid
  activationKey       ActivationKey? @relation(fields: [activationKeyId], references: [key_id])
}

enum CompanyStatus {
  ACTIVE
  EXPIRED
}

model ActivationKey {
  key_id       String    @id @db.Uuid
  key          String    @unique @db.VarChar(255)
  plan         String?   @db.VarChar(100)
  licence_type String?   @db.VarChar(100)
  start_date   DateTime?
  expires_at   DateTime?
  status       KeyStatus @default(ACTIVE)
  company      Company?
}

enum KeyStatus {
  ACTIVE
  EXPIRED
}

model Manager {
  manager_id    String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  password_hash String
  name          String?  @db.VarChar(255)
  phone         String?  @db.VarChar(20)
  address       String?  @db.VarChar(255)
  company       Company  @relation(fields: [companyId], references: [company_id])
  companyId     String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamp(6)

  passwordTokens PasswordToken[]
}

model PasswordToken {
  token_id   String   @id @db.Uuid
  token_hash String   @unique
  manager_id String   @db.Uuid
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  manager Manager @relation(fields: [manager_id], references: [manager_id])
}
